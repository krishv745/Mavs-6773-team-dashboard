# Supabase project settings — find these in Supabase dashboard under
# Project Settings > API. Copy this file to .env.local and fill in.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Powers the "Summarize with AI" button on the Admin Dashboard's Activity
# Report and the AI chat assistant. Also required for the Build tab's BOM
# import when pasting an Onshape link (instead of uploading a CSV) and for
# reading a vendor order PDF (CSV upload works without it). Get a key at
# console.anthropic.com.
ANTHROPIC_API_KEY=
